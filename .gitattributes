# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force these to always be LF
*.cs        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

# Binary files — never modify
*.png       binary
*.jpg       binary
*.ico       binary
*.svg       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
